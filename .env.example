# Plantilla de variables de entorno. Copia a .env y rellena tus claves:
#   cp .env.example .env
# (NO pegues claves reales aquí: este archivo se versiona.)

# --- LLM (opencode) ---
# Clave API de opencode Zen (https://opencode.ai/auth). Pégala en .env.
# Se usa para NLU, síntesis y conocimiento comunitario. Sin clave, fallback
# determinista.
OPENCODE_API_KEY=
# Modelo por defecto (OpenAI-compatible en el endpoint /chat/completions).
# Opciones: deepseek-v4-pro, deepseek-v4-flash, glm-5.3, kimi-k3, minimax-m3, ...
OPENCODE_MODEL=deepseek-v4-pro
# Base URL OpenAI-compatible de opencode.
OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# --- Telegram ---
# Token del bot de Telegram (de @BotFather). Pégala en .env para recibir
# consultas (texto o nota de voz) por chat con `npm run telegram`.
TELEGRAM_BOT_TOKEN=

# --- Speech-to-Text (Groq) ---
# Clave API de Groq (https://console.groq.com/keys). Pégala en .env.
# Se usa para transcribir notas de voz (Whisper). Sin clave, STT se degrada.
GROQ_API_KEY=
# Modelo Whisper de Groq para transcripción.
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- Fuentes de datos ---
# Endpoints de los portales CKAN / Socrata (no requieren token).
CKAN_BOGOTA=https://datosabiertos.bogota.gov.co/api/3/action
SOCRATA_CATALOG=https://api.us.socrata.com/api/catalog/v1
SOCRATA_DOMAIN=www.datos.gov.co

# --- Geocodificación ---
# Proveedor: "ideca" (oficial), "nominatim" (OSM) o "auto" (IDECA con fallback).
GEOCODE_PROVIDER=auto
# Nomenclátor de nombres geográficos de IDECA (no requiere token).
IDECA_GEOCODER_URL=https://serviciosgis.catastrobogota.gov.co/arcgis/rest/services/sitiosinteres/nombregeografico/MapServer/0/query
# Respaldo OSM (opcional).
# NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# --- GTFS ---
# Ruta o URL de un feed GTFS del SITP (zip o carpeta). Si se deja vacío, el
# orquestador usa el GTFS oficial en caché (npm run gtfs:sync) y, si no existe,
# la muestra local.
GTFS_PATH=
# Descargar automáticamente el GTFS oficial si no está en caché ("1" para sí).
GTFS_AUTO_DOWNLOAD=0
# Área de búsqueda (bbox) en formato "sur,oeste,norte,este". Por defecto es
# Ciudad Bolívar (límites oficiales IDECA). Usa "none" para desactivar el filtro.
GTFS_BBOX=4.383662,-74.213080,4.599759,-74.120422

# --- Transporte informal (GTFS-Flex) ---
# Endpoint de OpenTripPlanner 2 (usado por el Agente Orquestador de Viajes).
OTP_ENDPOINT=http://localhost:8080/otp/routers/default/index/graphql
# Directorio del feed GTFS-Flex de muestra (paradas continuas + grupos).
FLEX_PATH=data/sample_flex

# --- Base de conocimiento ---
# Archivo CSV donde se guarda cada consulta (para integrar un motor de base de
# datos más adelante). Por defecto data/consultas.csv.
# CONSULTAS_CSV=data/consultas.csv
# Archivo CSV donde se guardan los reportes de transporte informal (Telegram,
# WhatsApp, ...) con su nivel y fiabilidad. Por defecto data/reportes.csv.
# REPORTES_CSV=data/reportes.csv
# Antigüedad máxima (horas) de un reporte: pasado este tiempo desde el evento
# deja de afectar rutas, confianza y mapa, y no se rehidrata del CSV.
# REPORTES_TTL_HORAS=2

# --- API / mapa ---
# Puerto del servidor HTTP+SSE (solo escucha en 127.0.0.1).
API_PORT=8787
# URL del frontend (Vite dev server); se usa para armar el enlace del mapa que
# se envía por chat. En el celular, cambiar por la IP/túnel accesible desde ahí.
FRONTEND_URL=http://localhost:5173
# Umbral (0..1) de nivel de trancamiento a partir del cual una ruta se evita.
CONGESTION_UMBRAL=0.5
# Archivo donde se persisten las sesiones (chat ↔ mapa) entre reinicios.
SESIONES_JSON=data/sesiones.json
